# Copier vers .env.local puis renseigner les valeurs de `supabase status`
# (ou celles du projet Supabase distant).

# Clé publique (anon) — exposée au navigateur, protégée par les politiques RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aucune clé secrète (service_role) n'est requise côté client.
# Elle reste dans Supabase et n'est jamais importée dans le bundle navigateur.

# --- E-mails (notifications devis / affectations) ---
# Dev : SMTP local mailpit (npm run db:start inclut le service), boîte : http://localhost:54324
# Prod : RESEND_API_KEY prioritaire sur SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM="France Santé Transport <no-reply@example.com>"
NEXT_PUBLIC_APP_URL=http://localhost:3000
# RESEND_API_KEY=re_xxx

# --- Clé serveur (route handlers uniquement, jamais NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
